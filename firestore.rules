rules_version = '2';

// Regras de segurança do Firestore para o projeto Raízes (raizes-9e7b7).
//
// CONTEXTO: o app é estático (GitHub Pages) e a apiKey do Firebase é pública por
// design — ela NÃO é um segredo. A real barreira de segurança são ESTAS regras.
// Antes elas estavam abertas (qualquer um lia/escrevia/apagava tudo via REST).
// Agora, com login real (Firebase Auth), exigimos usuário autenticado.
//
// COMO PUBLICAR:
//   Opção A (Console): Firebase Console -> Firestore Database -> Rules ->
//                      colar este conteúdo -> Publicar.
//   Opção B (CLI):     firebase deploy --only firestore:rules
//
// LIMITAÇÃO CONHECIDA: o modelo de dados é compartilhado (o app carrega TODAS as
// famílias). Logo, qualquer usuário AUTENTICADO consegue ler/editar qualquer
// família. Isolamento por família exigiria uma lista de membros (uids) por família
// e reescrita do fluxo de leitura — fica como evolução futura.

service cloud.firestore {
  match /databases/{database}/documents {

    // Famílias: somente usuários autenticados.
    match /raizes_families/{familyId} {
      allow read, write: if request.auth != null;
    }

    // Membros: somente usuários autenticados.
    match /raizes_members/{memberId} {
      allow read, write: if request.auth != null;
    }

    // Auditoria: append-only e identidade não forjável.
    // - create exige que o userId gravado seja o do próprio usuário logado.
    // - update/delete proibidos (o histórico não pode ser alterado/apagado).
    match /raizes_audit/{entryId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Qualquer outra coleção: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
