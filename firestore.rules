rules_version = '2';

// ============================================================================
// Regras de segurança do Firestore — projeto raizes-9e7b7
// PRIVACIDADE POR FAMÍLIA: cada família é visível apenas para quem tem acesso.
//
// COMO FUNCIONA O ACESSO
//   - Cada família tem `memberUserIds` (UIDs com acesso) e `blockedUserIds`.
//   - Quem tem o CÓDIGO da família consulta o índice público
//     `raizes_family_index/{CODIGO}` -> descobre o familyId -> e se adiciona
//     a si mesmo em `memberUserIds` (a menos que esteja bloqueado).
//   - O DONO (`ownerUserId`) pode excluir a família e bloquear usuários.
//
// ROLLOUT EM 2 PASSOS (importante p/ não se trancar para fora):
//   1. PRIMEIRO entre no app já atualizado e logado UMA vez. Isso faz o app
//      preencher `memberUserIds` das famílias antigas (backfill automático).
//   2. SÓ DEPOIS publique ESTE arquivo:
//      https://console.firebase.google.com/project/raizes-9e7b7/firestore/rules
//      (cole tudo -> Publicar). Recomendado testar com uma segunda conta.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function familyData(familyId) {
      return get(/databases/$(database)/documents/raizes_families/$(familyId)).data;
    }

    function isMemberOf(familyId) {
      return isSignedIn() && request.auth.uid in familyData(familyId).memberUserIds;
    }

    // Índice público código -> família. O CÓDIGO é o segredo compartilhado:
    // quem o conhece pode descobrir o familyId para então entrar.
    match /raizes_family_index/{code} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // Famílias
    match /raizes_families/{familyId} {
      // Ler: só membros ou o dono. (As duas consultas do app — array-contains
      // uid e ownerUserId == uid — são validadas por esta regra.)
      allow read: if isSignedIn() && (
           request.auth.uid in resource.data.memberUserIds
        || resource.data.ownerUserId == request.auth.uid
      );

      // Criar: o criador é dono e já consta como membro.
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUserIds;

      // Atualizar:
      //  - membros e dono podem editar a família;
      //  - um usuário NÃO bloqueado pode se ADICIONAR (e somente a si mesmo)
      //    em memberUserIds — é assim que se "entra pelo código".
      allow update: if isSignedIn() && (
           request.auth.uid in resource.data.memberUserIds
        || resource.data.ownerUserId == request.auth.uid
        || (
             !(request.auth.uid in resource.data.get('blockedUserIds', []))
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUserIds'])
             && request.resource.data.memberUserIds.hasAll(resource.data.memberUserIds)
             && request.resource.data.memberUserIds.hasOnly(resource.data.memberUserIds.concat([request.auth.uid]))
           )
      );

      // Excluir: somente o dono.
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    // Membros: acessíveis apenas a quem é membro da família correspondente.
    match /raizes_members/{memberId} {
      allow read:   if isMemberOf(resource.data.familyId);
      allow create: if isMemberOf(request.resource.data.familyId);
      allow update: if isMemberOf(resource.data.familyId)
                    && isMemberOf(request.resource.data.familyId);
      allow delete: if isMemberOf(resource.data.familyId);
    }

    // Auditoria: append-only; leitura só por membros; identidade não forjável.
    match /raizes_audit/{entryId} {
      allow read:   if isMemberOf(resource.data.familyId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Qualquer outra coleção: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
